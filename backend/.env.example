# Backend-only secrets. Copy to backend/.env — never commit the real file.

# API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your_api_key_here

# Agent id from the agent URL or agent settings — starts with agent_ (not the display name)
# Example: agent_3701k3ttaq12ewp8b7qv5rfyszkz
ELEVENLABS_AGENT_ID=agent_your_agent_id_here

ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
ENVIRONMENT=development
